{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earmark.local/schemas/space.schema.json",
  "title": "Space",
  "description": "config/space.json. Physical layout relative to the calibrated listening position. Meters; +x right, +y forward, +z up.",
  "type": "object",
  "additionalProperties": false,
  "required": ["listener", "spots", "areas", "receivers"],
  "properties": {
    "listener": {
      "type": "object", "additionalProperties": false, "required": ["label", "origin_note"],
      "properties": { "label": { "type": "string" }, "origin_note": { "type": "string" } }
    },
    "spots": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["spot", "label", "position"],
        "properties": {
          "spot": { "type": "integer", "minimum": 0 },
          "label": { "type": "string", "minLength": 1, "description": "Spoken name, e.g. \"far left\"." },
          "position": { "$ref": "#/$defs/vec3" }
        }
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["area", "position"],
        "properties": {
          "area": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "description": "Spoken name, e.g. \"the counter\". Defaults to area id." },
          "position": { "$ref": "#/$defs/vec3" }
        }
      }
    },
    "receivers": {
      "type": "array",
      "description": "Proximity receivers (BLE scanners). An object seen `near` a receiver resolves to the receiver position with precision=proximity.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["receiver", "label"],
        "properties": {
          "receiver": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "description": "Spoken name, e.g. \"the counter\"." },
          "position": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/vec3" }] }
        }
      }
    }
  },
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
  }
}
