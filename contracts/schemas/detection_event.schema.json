{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earmark.local/schemas/detection_event.schema.json",
  "title": "DetectionEvent",
  "description": "Adapter -> hub. One raw observation from any detection method. Downstream of the hub nothing may depend on `source`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "source", "tag", "kind", "where", "precision", "t"],
  "properties": {
    "type": { "const": "detection" },
    "source": { "enum": ["simulator", "nfc", "ble", "camera", "ultrasonic"] },
    "tag": { "type": "string", "minLength": 1, "description": "NFC UID hex, BLE fob id, or any adapter-specific identity. EMPTY reads use kind=removed with the last tag seen, or tag=\"EMPTY\"." },
    "kind": { "enum": ["seen", "placed", "removed", "lost"] },
    "where": {
      "description": "Null only when kind=lost.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/where_spot" },
        { "$ref": "#/$defs/where_position" },
        { "$ref": "#/$defs/where_area" },
        { "$ref": "#/$defs/where_near" }
      ]
    },
    "precision": { "enum": ["exact", "area", "proximity", "none"] },
    "rssi": { "type": ["number", "null"], "description": "dBm, BLE only." },
    "t": { "type": "number", "description": "Unix seconds. In scenario files: seconds relative to scenario start." }
  },
  "$defs": {
    "where_spot": {
      "type": "object", "additionalProperties": false, "required": ["spot"],
      "properties": { "spot": { "type": "integer", "minimum": 0 } }
    },
    "where_position": {
      "type": "object", "additionalProperties": false, "required": ["position"],
      "properties": { "position": { "$ref": "#/$defs/vec3" } }
    },
    "where_area": {
      "type": "object", "additionalProperties": false, "required": ["area"],
      "properties": { "area": { "type": "string", "minLength": 1 } }
    },
    "where_near": {
      "type": "object", "additionalProperties": false, "required": ["near", "distance_class"],
      "properties": {
        "near": { "type": "string", "minLength": 1, "description": "receiver id from space.json" },
        "distance_class": { "enum": ["near", "mid", "far"] }
      }
    },
    "vec3": {
      "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3,
      "description": "[x, y, z] meters. +x right, +y forward, +z up, origin = calibrated listening position."
    }
  }
}
