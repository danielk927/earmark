{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earmark.local/schemas/object_state.schema.json",
  "title": "ObjectState",
  "description": "Hub -> bus and Convex. Where an item is: its saved spot (status on_spot), or missing when it has no saved spot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "object_id",
    "location",
    "precision",
    "status",
    "home_spot",
    "last_seen_t",
    "source",
    "t"
  ],
  "properties": {
    "type": {
      "const": "state_update"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "$ref": "#/$defs/location"
    },
    "precision": {
      "enum": [
        "exact",
        "area",
        "proximity",
        "none"
      ]
    },
    "status": {
      "enum": [
        "on_spot",
        "missing"
      ],
      "description": "on_spot: the item has a saved spot. missing: no saved spot yet."
    },
    "home_spot": {
      "type": [
        "integer",
        "null"
      ]
    },
    "last_seen_t": {
      "type": [
        "number",
        "null"
      ],
      "description": "Unix seconds of the last observation; null if never seen."
    },
    "source": {
      "enum": [
        "saved",
        "none"
      ],
      "description": "Informational only. Nothing downstream may branch on it."
    },
    "t": {
      "type": "number",
      "description": "Unix seconds when this state was computed."
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "description": "All fields optional/nullable. position is always filled when the hub can resolve one (spot, area, or receiver position).",
      "properties": {
        "spot": {
          "type": [
            "integer",
            "null"
          ]
        },
        "position": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        },
        "area": {
          "type": [
            "string",
            "null"
          ]
        },
        "near": {
          "type": [
            "string",
            "null"
          ]
        },
        "distance_class": {
          "enum": [
            "near",
            "mid",
            "far",
            null
          ]
        }
      }
    }
  }
}
