{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earmark.local/schemas/convex_http.schema.json",
  "title": "ConvexHttp",
  "description": "Request/response bodies of Earmark's Convex HTTP actions. All JSON is snake_case; Convex tables are camelCase internally and convert only in convex/http.ts. Auth: header `X-Earmark-Secret`. EARMARK_HUB_SECRET is accepted on every route; EARMARK_READ_SECRET only on GET /api/*. Times are unix seconds; *_local fields are ISO 8601 in the household timezone.",
  "$defs": {
    "ingest_request": {
      "description": "POST /ingest (hub). Idempotent by event_id.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "states"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hub_event"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "object_state.schema.json"
          }
        },
        "listener_pose": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "bus_message.schema.json#/$defs/listener_pose"
            }
          ],
          "description": "Latest listener pose, at most about 1 Hz (for the dashboard map). Optional."
        }
      }
    },
    "ingest_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "accepted_events",
        "duplicate_events",
        "accepted_states"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "accepted_events": {
          "type": "integer"
        },
        "duplicate_events": {
          "type": "integer"
        },
        "accepted_states": {
          "type": "integer"
        }
      }
    },
    "hub_event": {
      "description": "Append-only event. `data` holds the originating bus message.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "kind",
        "object_id",
        "t",
        "data"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 8,
          "description": "Hub-generated UUID; Convex ignores duplicates (offline-queue retries)."
        },
        "kind": {
          "enum": [
            "guide_start",
            "arrived",
            "guide_stop",
            "save_spot",
            "trial_start",
            "trial_end"
          ]
        },
        "object_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "t": {
          "type": "number"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "object_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "name",
        "aliases",
        "notes",
        "description",
        "home_spot",
        "home_spot_label",
        "is_medication",
        "fob_id",
        "state",
        "last_touched_t",
        "last_touched_local"
      ],
      "properties": {
        "object_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "home_spot": {
          "type": [
            "integer",
            "null"
          ]
        },
        "home_spot_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_medication": {
          "type": "boolean"
        },
        "fob_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "spot",
                "spot_label",
                "area",
                "near",
                "distance_class",
                "precision",
                "last_seen_t",
                "last_seen_local"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "on_spot",
                    "missing"
                  ]
                },
                "spot": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "spot_label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "area": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "near": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "distance_class": {
                  "enum": [
                    "near",
                    "mid",
                    "far",
                    null
                  ]
                },
                "precision": {
                  "enum": [
                    "exact",
                    "area",
                    "proximity",
                    "none"
                  ]
                },
                "last_seen_t": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "last_seen_local": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "last_touched_t": {
          "type": [
            "number",
            "null"
          ],
          "description": "Last time the user was guided to and arrived at this item."
        },
        "last_touched_local": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "object_lookup_response": {
      "description": "GET /api/object?name=  Case-insensitive match on name, then aliases, then substring. Zero or more matches, best first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "matches",
        "now_t",
        "now_local"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object_summary"
          }
        },
        "now_t": {
          "type": "number"
        },
        "now_local": {
          "type": "string"
        }
      }
    },
    "objects_response": {
      "description": "GET /api/objects  Every object, for questions like \"what hasn't been touched in a week?\".",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objects",
        "now_t",
        "now_local"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object_summary"
          }
        },
        "now_t": {
          "type": "number"
        },
        "now_local": {
          "type": "string"
        }
      }
    },
    "history_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "kind",
        "t",
        "at_local",
        "spot",
        "spot_label",
        "detail"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "t": {
          "type": "number"
        },
        "at_local": {
          "type": "string"
        },
        "spot": {
          "type": [
            "integer",
            "null"
          ]
        },
        "spot_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": "string",
          "description": "Deterministic human-readable sentence, e.g. \"Picked up from the center right spot.\""
        }
      }
    },
    "history_response": {
      "description": "GET /api/history?objectId=&since=  `since` is unix seconds; default 7 days ago. Newest first, max 200.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "name",
        "since_t",
        "events"
      ],
      "properties": {
        "object_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "since_t": {
          "type": "number"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/history_event"
          }
        }
      }
    },
    "dose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "name",
        "scheduled_local_time",
        "scheduled_for_t",
        "scheduled_for_local",
        "status",
        "found_t",
        "found_local",
        "evidence_event_id"
      ],
      "properties": {
        "object_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scheduled_local_time": {
          "type": "string",
          "description": "HH:MM as configured."
        },
        "scheduled_for_t": {
          "type": "number"
        },
        "scheduled_for_local": {
          "type": "string"
        },
        "status": {
          "enum": [
            "found",
            "late",
            "missed",
            "pending"
          ],
          "description": "Evidence is arrival at the medication's spot (the user was guided to and found it), not proof the dose was taken."
        },
        "found_t": {
          "type": [
            "number",
            "null"
          ]
        },
        "found_local": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_event_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "adherence_response": {
      "description": "GET /api/adherence?date=YYYY-MM-DD (household-local date; default today).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "timezone",
        "doses",
        "now_t"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "timezone": {
          "type": "string"
        },
        "doses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dose"
          }
        },
        "now_t": {
          "type": "number"
        }
      }
    },
    "daily_summary_response": {
      "description": "GET /api/daily-summary?date=  Deterministic facts only; `text` is generated by code, not an LLM. No medical advice.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "timezone",
        "generated_t",
        "doses",
        "find_count",
        "untouched_7d",
        "missing",
        "text"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "timezone": {
          "type": "string"
        },
        "generated_t": {
          "type": "number"
        },
        "doses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dose"
          }
        },
        "find_count": {
          "type": "integer",
          "description": "Guided finds (arrivals) on `date`."
        },
        "untouched_7d": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "object_ids not found (no arrival) in the 7 days before end of `date`."
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "object_ids whose current status is missing."
        },
        "text": {
          "type": "string"
        }
      }
    },
    "error_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      }
    },
    "registry_response": {
      "description": "GET /api/registry (hub, every ~2 s). The registry with a required non-null version (max objects.updatedAt in ms) so the hub can detect changes cheaply.",
      "allOf": [
        {
          "$ref": "registry.schema.json"
        },
        {
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "number"
            }
          }
        }
      ]
    },
    "spot_request": {
      "description": "POST /api/spot (hub): set an object's saved spot.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "position"
      ],
      "properties": {
        "object_id": {
          "type": "string"
        },
        "position": {
          "$ref": "bus_message.schema.json#/$defs/vec3"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "spot_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "object_id",
        "spot"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "object_id": {
          "type": "string"
        },
        "spot": {
          "type": "integer"
        }
      }
    }
  }
}
