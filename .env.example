# Earmark environment. Copy to .env (gitignored) and fill in the blanks.
# Every service loads the repo-root .env without overriding the real environment.
# Leave a key empty and that service falls back to its mock/offline path.
# Values marked "verified" were checked against official docs tonight; see docs/vendor-notes/.

# ---------------------------------------------------------------- local bus
# 0.0.0.0 lets the iPhone locator connect over the phone's hotspot; 127.0.0.1 keeps the bus off the LAN.
EARMARK_BUS_HOST=0.0.0.0
EARMARK_BUS_PORT=8765
# Shared token the iPhone locator (and any remote CLI) must present: ws://<mac>:8765/?token=<token>
# or header X-Earmark-Token. Empty = LAN clients refused. Generate: openssl rand -hex 16
EARMARK_BUS_TOKEN=
EARMARK_BUS_URL=ws://127.0.0.1:8765

# ---------------------------------------------------------------- Convex (docs/vendor-notes/convex.md)
# Written by `npx convex dev`; CONVEX_SITE_URL serves HTTP actions (/ingest, /api/*).
CONVEX_URL=
CONVEX_SITE_URL=
VITE_CONVEX_URL=
# Shared secrets for Convex HTTP actions (header X-Earmark-Secret). Generate: openssl rand -hex 24
# Also set them on the deployment: npx convex env set EARMARK_HUB_SECRET ... / EARMARK_READ_SECRET ...
EARMARK_HUB_SECRET=
EARMARK_READ_SECRET=

# ---------------------------------------------------------------- Cartesia (docs/vendor-notes/cartesia.md)
CARTESIA_API_KEY=
# verified: the only accepted version value in the current specs
CARTESIA_VERSION=2026-08-14
# verified: Ink 2 with built-in turn detection lives only on the turns endpoint
CARTESIA_STT_URL=wss://api.cartesia.ai/stt/turns/websocket
CARTESIA_STT_MODEL=ink-2
CARTESIA_STT_SAMPLE_RATE=16000
CARTESIA_TTS_URL=wss://api.cartesia.ai/tts/websocket
CARTESIA_TTS_BYTES_URL=https://api.cartesia.ai/tts/bytes
# verified: pinned snapshot so cached phrases and live speech sound identical
CARTESIA_TTS_MODEL=sonic-3.6-2026-08-27
# Pick a stable, realistic voice in the Cartesia playground and paste its ID.
CARTESIA_VOICE_ID=
CARTESIA_TTS_ENCODING=pcm_f32le
CARTESIA_TTS_SAMPLE_RATE=48000

# ---------------------------------------------------------------- Moss (docs/vendor-notes/moss.md)
# portal.usemoss.dev -> API Keys; redeem code CALHACKS on the billing page.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=earmark-objects

# ---------------------------------------------------------------- Bitdeer AI Model Studio (docs/vendor-notes/bitdeer.md)
# bitdeer.ai -> submit the credit request form -> Model Studio -> API keys.
BITDEER_API_KEY=
BITDEER_BASE_URL=https://api-inference.bitdeer.ai/v1
# Concierge tool selection (send reasoning_effort "none"; model IDs change fast, check GET /v1/models)
BITDEER_CHAT_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B
# Memory agent reasoning
BITDEER_AGENT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Photo-assisted labeling (multimodal). Set on the Convex deployment too: npx convex env set BITDEER_VISION_MODEL ...
BITDEER_VISION_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
LLM_TIMEOUT_S=1.5

# ---------------------------------------------------------------- Fetch.ai memory agent (docs/vendor-notes/fetchai.md)
# A long random secret phrase; the agent address is derived from it. Never commit it.
MEMORY_AGENT_SEED=
MEMORY_AGENT_NAME=earmark-memory
MEMORY_AGENT_PORT=8010

# ---------------------------------------------------------------- Azure (optional, docs/vendor-notes/azure.md)
AZURE_RESOURCE_GROUP=earmark-rg
AZURE_LOCATION=
