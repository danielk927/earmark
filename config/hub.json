{
  "adapters": ["simulator"],
  "bus": {
    "host": "127.0.0.1",
    "port": 8765,
    "client_queue_max": 1000
  },
  "debounce": {
    "placement_reads": 2,
    "removal_s": 1.5,
    "tick_s": 0.25
  },
  "simulator": {
    "poll_s": 0.5,
    "fob_poll_s": 1.0,
    "start_delay_s": 1.0,
    "fob_rssi": { "near": -55, "mid": -72, "far": -88 }
  },
  "nfc_serial": {
    "port_globs": [
      "/dev/cu.usbserial*",
      "/dev/cu.usbmodem*",
      "/dev/cu.SLAB_USBtoUART*",
      "/dev/cu.wchusbserial*"
    ],
    "baud": 115200,
    "reconnect_s": 2.0
  },
  "ble_fobs": {
    "receiver": "hub",
    "fobs": {
      "fob_keys": { "address": null, "name": null }
    },
    "ema_tau_s": 2.0,
    "stale_s": 10.0,
    "near_dbm": -65,
    "mid_dbm": -80,
    "emit_interval_s": 1.0,
    "chirp_timeout_s": 10.0,
    "connect_timeout_s": 10.0,
    "alert_service_uuid": "1802",
    "alert_char_uuid": "2a06",
    "alert_level": 1,
    "link_loss_service_uuid": "1803",
    "link_loss_value": null
  },
  "convex": {
    "registry_poll_s": 2.0,
    "timeout_s": 8.0,
    "flush_interval_s": 0.5,
    "batch_max": 100,
    "backoff_initial_s": 0.5,
    "backoff_max_s": 30.0
  },
  "uwb": {
    "enabled": true,
    "solve_hz": 10,
    "freshness_s": 0.5,
    "lost_after_s": 2.0,
    "lost_hold_s": 12.0,
    "auto_freeze": false,
    "max_speed_mps": 2.5,
    "outlier_rms_m": 0.25,
    "alpha": 0.5,
    "beta": 0.1,
    "alpha_still": 0.2,
    "phone_z": -0.35,
    "head_offset_m": 0.2,
    "head_pose_max_age_s": 0.5,
    "counter_ref": [0, 0],
    "freeze_enter_m": 1.0,
    "freeze_exit_m": 1.3,
    "still_for_s": 0.6,
    "average_window_s": 1.0,
    "unfreeze_move_m": 0.35,
    "blend_s": 0.4,
    "freeze_mode": "average",
    "reach_max_m": 0.75,
    "convex_pose_hz": 2.0
  },
  "uwb_sim": {
    "rate_hz": 15,
    "noise_sigma_m": 0.07,
    "dropout_prob": 0.03,
    "jump_m": 0.4,
    "block_every_s": 8.0,
    "block_s": 1.0,
    "path": [[0.4, -3.0], [0.1, -1.5], [0.0, 0.0]],
    "speed_mps": 0.6,
    "dwell_s": 4.0,
    "loop": true,
    "step_m": 0.25,
    "seed": null
  },
  "health": {
    "interval_s": 5.0
  },
  "paths": {
    "space": "config/space.json",
    "seed": "config/objects.seed.json",
    "cache": "config/objects.cache.json",
    "queue": "var/hub/queue.jsonl",
    "trials": "var/trials/trials.jsonl",
    "logs": "logs"
  }
}
